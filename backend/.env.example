# Smart Splitter — backend environment
PORT=8080
CORS_ORIGINS=http://localhost:4300,https://smart-splitter.vercel.app




# Google AI Studio — https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=AIzaSy...
# Any free-tier vision model. gemini-3.8-flash is the current default;
# older 2.x models are retired for new API keys.
GEMINI_MODEL=gemini-3.8-flash

SCAN_TIMEOUT_MS=25000
SCAN_RETRIES=3
DATABASE_FILE=data/smart-splitter.db
